# Application
PULSO_ENV=development
PULSO_API_ADDR=:8080
PULSO_DATABASE_URL=postgres://pulso:pulso@localhost:55432/pulso?sslmode=disable
PULSO_SHUTDOWN_TIMEOUT=10s
PULSO_WEB_ORIGIN=http://localhost:5173
PULSO_COOKIE_SECURE=false
PULSO_WORKER_CONCURRENCY=10
PULSO_WORKER_BATCH_SIZE=20
PULSO_WORKER_POLL_INTERVAL=1s
PULSO_CHECK_ALLOW_PRIVATE_HOSTS=
PULSO_SMTP_HOST=mailpit
PULSO_SMTP_PORT=1025
PULSO_SMTP_FROM=pulso@localhost

# Docker Compose PostgreSQL
POSTGRES_DB=pulso
POSTGRES_USER=pulso
POSTGRES_PASSWORD=pulso
POSTGRES_PORT=55432

# Docker Compose application ports
API_PORT=8080
WEB_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DEMO_TARGET_PORT=8081
