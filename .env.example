# Application
PULSO_ENV=development
PULSO_API_ADDR=:8080
PULSO_DATABASE_URL=postgres://pulso:pulso@localhost:5432/pulso?sslmode=disable
PULSO_SHUTDOWN_TIMEOUT=10s

# Docker Compose PostgreSQL
POSTGRES_DB=pulso
POSTGRES_USER=pulso
POSTGRES_PASSWORD=pulso
POSTGRES_PORT=5432

# Docker Compose application ports
API_PORT=8080
WEB_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
